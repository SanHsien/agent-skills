root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.ps1]
indent_size = 4

# Upstream product content: do not reformat to satisfy an editor setting.
[{skills,commands,agents,hooks,references,evals,scripts,docs}/**]
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
